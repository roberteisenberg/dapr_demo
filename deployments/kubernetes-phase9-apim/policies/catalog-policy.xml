<policies>
    <inbound>
        <base />

        <!-- Rate limiting: 1000 requests per minute per IP -->
        <rate-limit-by-key calls="1000"
                          renewal-period="60"
                          counter-key="@(context.Request.IpAddress)" />

        <!-- Check cache first -->
        <cache-lookup vary-by-developer="false"
                      vary-by-developer-groups="false"
                      downstream-caching-type="public"
                      caching-type="internal">
            <vary-by-header>Accept</vary-by-header>
        </cache-lookup>

        <!-- Route through nginx-ingress in AKS, which uses Dapr for service invocation.
             APIM cloud gateway has no Dapr sidecar, so it routes to nginx-ingress
             (app-id: api-gateway) which forwards via Dapr mTLS to catalog-service. -->
        <set-backend-service backend-id="nginx-ingress-backend" />

        <!-- Rewrite path: /api/v1/catalog{suffix} -> /apim/v1.0/invoke/catalog-service/method/products{suffix}
             Uses OriginalUrl.Path because Url.Path is null after set-backend-service.
             The /apim prefix is stripped by nginx-ingress rewrite-target annotation. -->
        <rewrite-uri template="@{
            var path = context.Request.OriginalUrl.Path;
            var basePath = "/api/v1/catalog";
            var suffix = path.Length > basePath.Length ? path.Substring(basePath.Length) : "";
            return "/apim/v1.0/invoke/catalog-service/method/products" + suffix;
        }" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Cache response for 60 seconds -->
        <cache-store duration="60" />
        <!-- Add cache status header for debugging -->
        <set-header name="X-Cache-Status" exists-action="override">
            <value>@(context.Response.Headers.ContainsKey("X-Cache") ? "HIT" : "MISS")</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
